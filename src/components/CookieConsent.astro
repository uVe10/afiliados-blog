---
/**
 * Banner de consentimiento de cookies + carga condicional del Pinterest Tag.
 *
 * Cumplimiento: el Pinterest Tag (s.pinimg.com/ct/core.js) NO se ejecuta hasta
 * que el usuario pulsa "Aceptar". La preferencia se guarda en localStorage con
 * clave propia (`oth-cookie-consent`), no en una cookie de Pinterest.
 *   - "accepted" -> se carga el tag (y en visitas futuras se carga sin banner).
 *   - "rejected" -> no se carga nunca y no se vuelve a mostrar el banner.
 *   - sin valor  -> se muestra el banner y el tag permanece inactivo.
 */
import { withBase } from '../lib/url';

const privacidadHref = withBase('/privacidad');
---

<div
  id="cookie-consent"
  class="cookie-consent"
  role="dialog"
  aria-label="Aviso de cookies"
  aria-live="polite"
  hidden
>
  <p class="cookie-text">
    Usamos cookies de Pinterest para medir el origen de las visitas. Puedes
    aceptar o rechazar. <a href={privacidadHref}>Más información</a>.
  </p>
  <div class="cookie-actions">
    <button type="button" id="cookie-reject" class="cookie-btn cookie-btn--ghost">
      Rechazar
    </button>
    <button type="button" id="cookie-accept" class="cookie-btn cookie-btn--primary">
      Aceptar
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'oth-cookie-consent';

    // Bootstrap oficial del Pinterest Tag, encapsulado para ejecutarse SOLO
    // bajo consentimiento. Idempotente: no se dispara dos veces.
    function loadPinterestTag() {
      if (window.__othPinterestLoaded) return;
      window.__othPinterestLoaded = true;
      !(function (e) {
        if (!window.pintrk) {
          window.pintrk = function () {
            window.pintrk.queue.push(Array.prototype.slice.call(arguments));
          };
          var n = window.pintrk;
          n.queue = [];
          n.version = '3.0';
          var t = document.createElement('script');
          t.async = !0;
          t.src = e;
          var r = document.getElementsByTagName('script')[0];
          r.parentNode.insertBefore(t, r);
        }
      })('https://s.pinimg.com/ct/core.js');
      window.pintrk('load', '2612597048782');
      window.pintrk('page');
    }

    var consent = null;
    try {
      consent = localStorage.getItem(KEY);
    } catch (e) {}

    if (consent === 'accepted') {
      // Preferencia previa: cargar sin volver a preguntar.
      loadPinterestTag();
      return;
    }
    if (consent === 'rejected') {
      // Rechazado: no cargar nada ni mostrar el banner.
      return;
    }

    // Sin respuesta previa: mostrar el banner. El script va después del markup,
    // así que el nodo ya existe en el DOM.
    var banner = document.getElementById('cookie-consent');
    if (!banner) return;
    banner.hidden = false;

    function decide(value) {
      try {
        localStorage.setItem(KEY, value);
      } catch (e) {}
      banner.hidden = true;
    }

    document.getElementById('cookie-accept').addEventListener('click', function () {
      decide('accepted');
      loadPinterestTag();
    });
    document.getElementById('cookie-reject').addEventListener('click', function () {
      decide('rejected');
    });
  })();
</script>

<style>
  .cookie-consent {
    position: fixed;
    left: 50%;
    bottom: 16px;
    transform: translateX(-50%);
    z-index: 1000;
    width: calc(100% - 24px);
    max-width: 560px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px 18px;
    background: var(--surface);
    border: 1px solid var(--divider);
    border-radius: 10px;
    box-shadow: var(--sombra-card);
  }
  /* El atributo `hidden` se aplica vía JS para ocultar el banner. Sin esta
     regla, `.cookie-consent { display: flex }` (estilo de autor) gana sobre el
     `[hidden] { display: none }` del user-agent, y el banner nunca se oculta. */
  .cookie-consent[hidden] {
    display: none;
  }
  @media (min-width: 560px) {
    .cookie-consent {
      flex-direction: row;
      align-items: center;
    }
  }
  .cookie-text {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-muted);
    flex: 1;
  }
  .cookie-text a {
    color: var(--sage-dark);
    font-weight: 600;
  }
  .cookie-actions {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }
  .cookie-btn {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 13px;
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    border: 1px solid transparent;
    line-height: 1;
  }
  .cookie-btn--primary {
    background: var(--mustard);
    color: var(--ink);
  }
  .cookie-btn--primary:hover {
    background: var(--mustard-dark);
  }
  .cookie-btn--ghost {
    background: transparent;
    color: var(--ink-muted);
    border-color: var(--divider);
  }
  .cookie-btn--ghost:hover {
    border-color: var(--sage);
    color: var(--ink);
  }
</style>
