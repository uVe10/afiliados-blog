---
/** Pie con la divulgación obligatoria de afiliados de Amazon + Pinterest. */
import { withBase } from '../lib/url';

const PINTEREST = 'https://es.pinterest.com/OrganizaTuHogarOficial';
const privacidadHref = withBase('/privacidad');
---

<footer class="site-footer">
  <p class="disclosure">
    Como afiliados de Amazon, OrganizaTuHogar obtiene ingresos por las compras
    que cumplen los requisitos aplicables. Esto no supone ningún coste
    adicional para ti.
  </p>
  <nav class="footer-links" aria-label="Enlaces legales">
    <a href={PINTEREST} rel="noopener" class="pinterest">Síguenos en Pinterest →</a>
    <a href={privacidadHref} class="privacy">Política de Privacidad</a>
  </nav>
</footer>

<style>
  .site-footer {
    padding: 20px 16px;
    border-top: 1px solid var(--divider);
    background: var(--bg);
  }
  @media (min-width: 720px) {
    .site-footer {
      padding: 40px 48px;
    }
  }
  .disclosure {
    font-size: 12px;
    line-height: 1.6;
    color: var(--ink-muted);
    margin: 0 0 10px;
    font-style: italic;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }
  .pinterest,
  .privacy {
    font-size: 13px;
    font-weight: 700;
    color: var(--sage-dark);
  }
</style>
