---
import BaseLayout from '../layouts/BaseLayout.astro';
import { navArticles } from '../lib/articles';
import { withBase } from '../lib/url';

// Enlaces de rescate: home + las categorías reales (mismos que la nav).
const homeHref = withBase('/');
const links = navArticles.map((art) => ({
  label: art.categoria,
  href: withBase(`/articulos/${art.slug}`),
}));
---

<BaseLayout
  title="Página no encontrada (404) — OrganizaTuHogar"
  description="La página que buscas no existe o se ha movido. Vuelve al inicio o explora nuestras comparativas de organización del hogar."
>
  <main class="notfound">
    <span class="code">404</span>
    <h1>Aquí no hay nada que organizar</h1>
    <p class="lead">
      La página que buscas no existe o se ha movido. Puedes volver al inicio o
      echar un vistazo a nuestras comparativas.
    </p>

    <a class="home-cta" href={homeHref}>Volver al inicio</a>

    <nav class="rescue" aria-label="Categorías">
      {links.map((l) => (
        <a href={l.href} class="chip">{l.label}</a>
      ))}
    </nav>
  </main>
</BaseLayout>

<style>
  .notfound {
    padding: 48px 16px 64px;
    max-width: 640px;
  }
  @media (min-width: 720px) {
    .notfound {
      padding: 72px 48px 96px;
    }
  }
  .code {
    display: inline-block;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.08em;
    color: #fff;
    background: var(--sage);
    padding: 4px 10px;
    border-radius: 3px;
    margin-bottom: 16px;
  }
  .notfound h1 {
    font-weight: 800;
    font-size: 28px;
    margin: 0 0 12px;
  }
  @media (min-width: 720px) {
    .notfound h1 {
      font-size: 42px;
    }
  }
  .lead {
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-muted);
    margin: 0 0 24px;
  }
  .home-cta {
    display: inline-block;
    background: var(--mustard);
    color: var(--ink);
    font-weight: 700;
    font-size: 14px;
    padding: 11px 22px;
    border-radius: 6px;
  }
  .home-cta:hover {
    background: var(--mustard-dark);
    text-decoration: none;
  }
  .rescue {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }
  .chip {
    padding: 6px 12px;
    border: 1px solid var(--divider);
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
    background: var(--surface);
  }
  .chip:hover {
    text-decoration: none;
    border-color: var(--sage);
  }
</style>
