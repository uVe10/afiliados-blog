---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import QuickView from '../../components/QuickView.astro';
import { articles, formatDate } from '../../lib/articles';
import { imageExists } from '../../lib/images';
import { productAnchor } from '../../lib/slug';
import type { PriceTagVariant } from '../../types';

export function getStaticPaths() {
  return articles.map((art) => ({
    params: { slug: art.slug },
    props: { art },
  }));
}

const { art } = Astro.props;

// Etiqueta firma por defecto: A (troquelada / Dymo).
const LABEL_VARIANT: PriceTagVariant = 'A';

// Enriquecemos cada producto con id de ancla, índice y texto de búsqueda.
const productos = art.productos.map((p, i) => {
  const id = productAnchor(p.nombre, i);
  const haystack = [p.nombre, p.descripcion, ...p.pros, p.rating_texto, p.precio_texto]
    .join(' ')
    .toLowerCase();
  return { ...p, id, index: String(i + 1).padStart(2, '0'), haystack, hasImage: imageExists(p.imagen) };
});
---

<BaseLayout
  title={art.meta_titulo}
  description={art.meta_descripcion}
  image={art.imagen_portada}
  imageAlt={art.portada_alt}
  headline={art.titulo_articulo}
  article={{ publishedTime: art.fecha_publicacion, modifiedTime: art.fecha_modificacion }}
>
  <main class="article">
    <span class="badge">{art.categoria.toUpperCase()}</span>
    <h1 class="title">{art.titulo_articulo}</h1>
    <p class="meta">
      Actualizado el {formatDate(art.fecha_modificacion)} · Este artículo contiene enlaces de afiliado
    </p>
    <p class="intro">{art.intro}</p>

    {art.metodologia && (
      <section class="editorial">
        <h2>{art.metodologia.titulo}</h2>
        <p>{art.metodologia.texto}</p>
      </section>
    )}

    <!-- Vista rápida -->
    <details class="section" open>
      <summary><h2>Vista rápida</h2><span class="chev" aria-hidden="true">▾</span></summary>
      <QuickView
        items={productos.map((p) => ({
          nombre: p.nombre,
          imagen: p.imagen,
          hasImage: p.hasImage,
          alt_text: p.alt_text,
          precio_texto: p.precio_texto,
          rating_texto: p.rating_texto,
          href: `#${p.id}`,
          attrs: { 'data-search': p.haystack },
        }))}
        variant={LABEL_VARIANT}
        maxHeight={380}
      />
    </details>

    <!-- Índice -->
    <details class="section" open>
      <summary><h2>Índice</h2><span class="chev" aria-hidden="true">▾</span></summary>
      <ol class="index">
        {productos.map((p) => (
          <li data-search={p.haystack}>
            <a href={`#${p.id}`}>
              <span class="index-num">{p.index}</span>
              <span class="index-name">{p.nombre}</span>
            </a>
          </li>
        ))}
      </ol>
    </details>

    <!-- Productos + buscador -->
    <details class="section" open>
      <summary><h2>Productos</h2><span class="chev" aria-hidden="true">▾</span></summary>

      <label class="search-label" for="filtro">BUSCAR EN ESTA COMPARATIVA</label>
      <div class="search-wrap">
        <input
          type="text"
          id="filtro"
          class="search-input"
          placeholder="ej. antideslizante, herméticos, 4,8..."
          autocomplete="off"
          data-filter
        />
      </div>

      <p class="no-matches" data-no-matches hidden>
        No encontramos productos que coincidan con «<span data-term></span>».
      </p>

      <div class="cards" data-cards>
        {productos.map((p) => (
          <div class="card-slot" data-search={p.haystack}>
            <ProductCard producto={p} id={p.id} variant={LABEL_VARIANT} />
          </div>
        ))}
      </div>
    </details>

    {art.resumen && (
      <section class="wrap-up">
        <h2>En resumen</h2>
        <p>{art.resumen}</p>
      </section>
    )}
  </main>
</BaseLayout>

<script>
  // Buscador cliente: filtra por el atributo data-search de cada elemento.
  // Mejora progresiva — sin JS, se ven todos los productos.
  const input = document.querySelector<HTMLInputElement>('[data-filter]');
  const term = document.querySelector<HTMLElement>('[data-term]');
  const noMatches = document.querySelector<HTMLElement>('[data-no-matches]');
  const cards = document.querySelector<HTMLElement>('[data-cards]');

  if (input) {
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      // Filtra cards de producto, filas de vista rápida e índice a la vez.
      document.querySelectorAll<HTMLElement>('[data-search]').forEach((el) => {
        const match = q === '' || (el.dataset.search ?? '').includes(q);
        el.hidden = !match;
      });
      const visibleCards = cards
        ? cards.querySelectorAll<HTMLElement>('.card-slot:not([hidden])').length
        : 0;
      if (noMatches && term) {
        const show = q !== '' && visibleCards === 0;
        noMatches.hidden = !show;
        if (show) term.textContent = input.value;
      }
    });
  }
</script>

<style>
  .article {
    padding: 20px 16px 32px;
  }
  @media (min-width: 720px) {
    .article {
      padding: 40px 48px 56px;
    }
  }

  .badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    background: var(--sage);
    color: #fff;
    padding: 4px 10px;
    border-radius: 3px;
    margin-bottom: 12px;
  }
  .title {
    font-weight: 800;
    font-size: 28px;
    margin: 0 0 10px;
  }
  @media (min-width: 720px) {
    .title {
      font-size: 42px;
    }
  }
  .meta {
    font-size: 13px;
    color: var(--ink-muted);
    margin: 0 0 16px;
  }
  .intro {
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink);
    opacity: 0.9;
    margin: 0 0 28px;
    max-width: 680px;
  }

  /* Bloque editorial (H2 con keyword + párrafo), antes de las cards */
  .editorial {
    margin: 0 0 32px;
    max-width: 680px;
  }
  .editorial h2 {
    font-weight: 700;
    font-size: 20px;
    margin: 0 0 10px;
  }
  .editorial p {
    font-size: 15px;
    line-height: 1.65;
    color: var(--ink);
    opacity: 0.85;
    margin: 0;
  }

  /* Secciones colapsables */
  .section {
    margin-bottom: 32px;
  }
  .section > summary {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    list-style: none;
    margin-bottom: 12px;
  }
  .section > summary::-webkit-details-marker {
    display: none;
  }
  .section > summary h2 {
    font-weight: 700;
    font-size: 20px;
    margin: 0;
  }
  .chev {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--sage);
    transition: transform 0.15s ease;
  }
  .section[open] > summary .chev {
    transform: rotate(0deg);
  }
  .section:not([open]) > summary .chev {
    transform: rotate(-90deg);
  }

  /* Índice */
  .index {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2px 20px;
  }
  @media (min-width: 720px) {
    .index {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .index li {
    min-width: 0;
  }
  .index a {
    display: flex;
    gap: 10px;
    align-items: baseline;
    font-size: 14px;
    color: var(--ink);
    padding: 6px 0;
    border-bottom: 1px solid var(--divider);
  }
  .index-num {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--mustard);
    font-size: 13px;
    flex-shrink: 0;
  }
  .index-name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Buscador */
  .search-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--ink);
    opacity: 0.6;
    margin-bottom: 6px;
  }
  .search-wrap {
    max-width: 420px;
  }
  .search-input {
    width: 100%;
    padding: 10px 14px;
    font-size: 14px;
    font-family: var(--font-body);
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--divider);
    border-radius: 6px;
  }
  .search-input:focus {
    border-color: var(--sage);
    outline: 2px solid var(--sage);
    outline-offset: 1px;
  }
  .no-matches {
    font-size: 14px;
    color: var(--ink);
    opacity: 0.6;
    margin: 24px 0 0;
  }

  .cards {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 20px;
  }
  @media (min-width: 720px) {
    .cards {
      gap: 24px;
    }
  }

  .wrap-up {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--divider);
  }
  .wrap-up h2 {
    font-weight: 700;
    font-size: 20px;
    margin: 0 0 10px;
  }
  .wrap-up p {
    font-size: 15px;
    line-height: 1.65;
    color: var(--ink);
    opacity: 0.85;
    margin: 0;
    max-width: 680px;
  }
</style>
