---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  /** Titular del Schema (H1 visible). Ver BaseHead. */
  headline?: string;
  article?: {
    publishedTime: string;
    modifiedTime: string;
  };
}

const { title, description, image, imageAlt, headline, article } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      headline={headline}
      article={article}
    />
  </head>
  <body>
    <div class="canvas-outer">
      <div class="canvas">
        <Header />
        <slot />
        <Footer />
      </div>
    </div>
  </body>
</html>
